<sdf version="1.9">
    <world name="world_demo">
        <!-- Provides physics engine for interactions with objects -->
        <physics name="1ms" type="ode">
            <max_step_size>0.003</max_step_size>
            <real_time_update_rate>1000.0</real_time_update_rate>
            <real_time_factor>1.0</real_time_factor>
        </physics>
        <!-- Provides the necessary Gazebo plugins for the simulation -->
        <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics" />
        <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands" />
        <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster" />

        <!-- Provides the necessary sensor plugins for the simulation -->
        <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
        <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu" />

        <!-- Configures the graphical user interface for Gazebo -->
        <gui fullscreen="0">
            <plugin filename="MinimalScene" name="3D View">
                <gz-gui>
                    <title>3D View</title>
                    <property type="bool" key="showTitleBar">false</property>
                    <property type="string" key="state">docked</property>
                </gz-gui>

                <engine>ogre2</engine>
                <scene>scene</scene>
                <ambient_light>0.4 0.4 0.4</ambient_light>
                <background_color>0.8 0.8 0.8</background_color>
                <camera_pose>0 0 8 0 1.5708 0</camera_pose>
                <camera_clip>
                    <near>0.25</near>
                    <far>25000</far>
                </camera_clip>
            </plugin>

            <!-- Scene manager plugin -->
            <plugin filename="GzSceneManager" name="Scene Manager">
                <gz-gui>
                    <property key="resizable" type="bool">false</property>
                    <property key="width" type="double">5</property>
                    <property key="height" type="double">5</property>
                    <property key="state" type="string">floating</property>
                    <property key="showTitleBar" type="bool">false</property>
                </gz-gui>
            </plugin>

            <!-- World control buttons-->
            <plugin filename="WorldControl" name="World control">
                <gz-gui>
                    <title>World control</title>
                    <property type="bool" key="showTitleBar">false</property>
                    <property type="bool" key="resizable">false</property>
                    <property type="double" key="height">72</property>
                    <property type="double" key="width">121</property>
                    <property type="double" key="z">1</property>

                    <property type="string" key="state">floating</property>
                    <anchors target="3D View">
                        <line own="left" target="left" />
                        <line own="bottom" target="bottom" />
                    </anchors>
                </gz-gui>

                <play_pause>true</play_pause>
                <step>true</step>
                <start_paused>false</start_paused>
                <service>/world/world_demo/control</service>
                <stats_topic>/world/world_demo/stats</stats_topic>
            </plugin>

            <!-- World statistics -->
            <plugin filename="WorldStats" name="World stats">
                <gz-gui>
                    <title>World stats</title>
                    <property type="bool" key="showTitleBar">false</property>
                    <property type="bool" key="resizable">false</property>
                    <property type="double" key="height">110</property>
                    <property type="double" key="width">290</property>
                    <property type="double" key="z">1</property>

                    <property type="string" key="state">floating</property>
                    <anchors target="3D View">
                        <line own="right" target="right" />
                        <line own="bottom" target="bottom" />
                    </anchors>
                </gz-gui>

                <sim_time>true</sim_time>
                <real_time>true</real_time>
                <real_time_factor>true</real_time_factor>
                <iterations>true</iterations>
                <topic>/world/world_demo/stats</topic>
            </plugin>

            <!-- Interactive view control plugin -->
            <plugin filename="InteractiveViewControl" name="Interactive view control">
                <gz-gui>
                    <property key="resizable" type="bool">false</property>
                    <property key="width" type="double">5</property>
                    <property key="height" type="double">5</property>
                    <property key="state" type="string">floating</property>
                    <property key="showTitleBar" type="bool">false</property>
                </gz-gui>
            </plugin>

            <!-- Entitiy selection plugin -->
            <plugin filename="SelectEntities" name="Select Entities">
                <gz-gui>
                    <anchors target="Interactive view control">
                        <line own="right" target="left" />
                        <line own="top" target="top" />
                    </anchors>
                    <property key="resizable" type="bool">false</property>
                    <property key="width" type="double">5</property>
                    <property key="height" type="double">5</property>
                    <property key="state" type="string">floating</property>
                    <property key="showTitleBar" type="bool">false</property>
                </gz-gui>
            </plugin>
        </gui>

        <!-- Provide directional light for the simulation -->
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- Provides the floor for the robot -->
        <include>
            <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
        </include>

        <!--
            Cardboard city fixtures.

            Landmark poses are treated as robot observation poses from
            tourbot_landmarks/config/cardboard_city/landmarks.yaml. Each tag is
            mounted about 45 cm in front of that observation pose, with the tag
            face normal pointing back toward the robot. The tag model side
            length is 0.162 m, matching tourbot_perception/config/apriltags_36h11.yaml.

            Boundary walls and cardboard box markers include matching collision
            shapes so Gazebo physics and the visible scene agree. Door panels
            remain visual-only in this demo because their open/closed state is
            driven by pose updates; a collision-enabled door should be modeled
            as a dynamic jointed entity in the SITL/high-fidelity layer.
        -->

        <model name="cardboard_city_visual_walls">
            <static>true</static>
            <link name="link">
                <visual name="north_wall_west">
                    <pose>0.405 1.05 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>1.61 0.05 0.50</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.62 0.46 0.27 1</ambient>
                        <diffuse>0.62 0.46 0.27 1</diffuse>
                    </material>
                </visual>
                <visual name="north_wall_east">
                    <pose>3.105 1.05 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>1.79 0.05 0.50</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.62 0.46 0.27 1</ambient>
                        <diffuse>0.62 0.46 0.27 1</diffuse>
                    </material>
                </visual>
                <visual name="south_wall_west">
                    <pose>1.12 -1.05 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>3.04 0.05 0.50</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.62 0.46 0.27 1</ambient>
                        <diffuse>0.62 0.46 0.27 1</diffuse>
                    </material>
                </visual>
                <visual name="south_wall_east">
                    <pose>3.82 -1.05 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.36 0.05 0.50</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.62 0.46 0.27 1</ambient>
                        <diffuse>0.62 0.46 0.27 1</diffuse>
                    </material>
                </visual>
                <visual name="west_wall">
                    <pose>-0.35 0 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.05 2.1 0.50</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.62 0.46 0.27 1</ambient>
                        <diffuse>0.62 0.46 0.27 1</diffuse>
                    </material>
                </visual>
                <visual name="east_wall">
                    <pose>4.05 0 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.05 2.1 0.50</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.62 0.46 0.27 1</ambient>
                        <diffuse>0.62 0.46 0.27 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="door_outward_panel">
            <static>true</static>
            <pose>3.14 -0.53 0.42 0 0 0</pose>
            <link name="link">
                <visual name="panel_visual">
                    <geometry>
                        <box>
                            <size>0.72 0.035 0.84</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.72 0.54 0.31 1</ambient>
                        <diffuse>0.72 0.54 0.31 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="door_inward_panel">
            <static>true</static>
            <pose>1.71 0.53 0.42 0 0 0</pose>
            <link name="link">
                <visual name="panel_visual">
                    <geometry>
                        <box>
                            <size>0.72 0.035 0.84</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.72 0.54 0.31 1</ambient>
                        <diffuse>0.72 0.54 0.31 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="cardboard_city_door_and_box_panels">
            <static>true</static>
            <link name="link">
                <visual name="box_goal_3">
                    <pose>0.45 0.495 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.42 0.50</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.66 0.48 0.26 1</ambient>
                        <diffuse>0.66 0.48 0.26 1</diffuse>
                    </material>
                </visual>
                <visual name="box_goal_4">
                    <pose>1.84 -0.2 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.42 0.50</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.66 0.48 0.26 1</ambient>
                        <diffuse>0.66 0.48 0.26 1</diffuse>
                    </material>
                </visual>
                <visual name="box_goal_5">
                    <pose>3.87 -0.2 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.42 0.50</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.66 0.48 0.26 1</ambient>
                        <diffuse>0.66 0.48 0.26 1</diffuse>
                    </material>
                </visual>
                <visual name="box_goal_6">
                    <pose>1.83 -0.647 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.42 0.50</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.66 0.48 0.26 1</ambient>
                        <diffuse>0.66 0.48 0.26 1</diffuse>
                    </material>
                </visual>
                <visual name="box_goal_7">
                    <pose>2.86 0.673 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.42 0.50</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.66 0.48 0.26 1</ambient>
                        <diffuse>0.66 0.48 0.26 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="cardboard_city_static_collisions">
            <static>true</static>
            <link name="link">
                <collision name="north_wall_west_collision">
                    <pose>0.405 1.05 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>1.61 0.05 0.50</size>
                        </box>
                    </geometry>
                </collision>
                <collision name="north_wall_east_collision">
                    <pose>3.105 1.05 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>1.79 0.05 0.50</size>
                        </box>
                    </geometry>
                </collision>
                <collision name="south_wall_west_collision">
                    <pose>1.12 -1.05 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>3.04 0.05 0.50</size>
                        </box>
                    </geometry>
                </collision>
                <collision name="south_wall_east_collision">
                    <pose>3.82 -1.05 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.36 0.05 0.50</size>
                        </box>
                    </geometry>
                </collision>
                <collision name="west_wall_collision">
                    <pose>-0.35 0 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.05 2.1 0.50</size>
                        </box>
                    </geometry>
                </collision>
                <collision name="east_wall_collision">
                    <pose>4.05 0 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.05 2.1 0.50</size>
                        </box>
                    </geometry>
                </collision>
                <collision name="box_goal_3_collision">
                    <pose>0.45 0.495 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.42 0.50</size>
                        </box>
                    </geometry>
                </collision>
                <collision name="box_goal_4_collision">
                    <pose>1.84 -0.2 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.42 0.50</size>
                        </box>
                    </geometry>
                </collision>
                <collision name="box_goal_5_collision">
                    <pose>3.87 -0.2 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.42 0.50</size>
                        </box>
                    </geometry>
                </collision>
                <collision name="box_goal_6_collision">
                    <pose>1.83 -0.647 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.42 0.50</size>
                        </box>
                    </geometry>
                </collision>
                <collision name="box_goal_7_collision">
                    <pose>2.86 0.673 0.25 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.42 0.50</size>
                        </box>
                    </geometry>
                </collision>
            </link>
        </model>

        <include>
            <name>apriltag_home_0</name>
            <uri>model://tag36_11_00000</uri>
            <pose>0 0.45 0.45 0 1.5708 -1.5708</pose>
        </include>

        <include>
            <name>apriltag_door_outward_1</name>
            <uri>model://tag36_11_00001</uri>
            <pose>3.14 -0.45 0.45 0 1.5708 1.5708</pose>
        </include>

        <include>
            <name>apriltag_door_inward_2</name>
            <uri>model://tag36_11_00002</uri>
            <pose>1.71 0.45 0.45 0 1.5708 -1.5708</pose>
        </include>

        <include>
            <name>apriltag_goal_3</name>
            <uri>model://tag36_11_00003</uri>
            <pose>0.492 0.495 0.45 0 1.5708 0</pose>
        </include>

        <include>
            <name>apriltag_goal_4</name>
            <uri>model://tag36_11_00004</uri>
            <pose>1.78 -0.2 0.45 0 1.5708 3.1416</pose>
        </include>

        <include>
            <name>apriltag_goal_5</name>
            <uri>model://tag36_11_00005</uri>
            <pose>3.81 -0.2 0.45 0 1.5708 3.1416</pose>
        </include>

        <include>
            <name>apriltag_goal_6</name>
            <uri>model://tag36_11_00006</uri>
            <pose>1.89 -0.647 0.45 0 1.5708 0</pose>
        </include>

        <include>
            <name>apriltag_goal_7</name>
            <uri>model://tag36_11_00007</uri>
            <pose>2.80 0.673 0.45 0 1.5708 3.1416</pose>
        </include>

    </world>
</sdf>
